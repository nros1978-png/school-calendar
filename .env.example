# .env.example
# ==============================================================================
# NOTE: The School Calendar & Gantt Application is a client-side static web
# application hosted directly on GitHub Pages. It DOES NOT use runtime
# environment variables (.env files are NOT loaded in the browser).
#
# The Firebase client configuration is public and intentionally located in:
#   - js/config.js
#   - index.html (inlined)
#
# If you containerize the project, introduce a Vite/Node build pipeline, or
# deploy via Firebase Hosting in the future, you may map the following variables:
# ==============================================================================

# Firebase Public Client Keys (Safe to expose in frontend bundles)
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=school-calendar-gantt.firebaseapp.com
FIREBASE_PROJECT_ID=school-calendar-gantt
FIREBASE_STORAGE_BUCKET=school-calendar-gantt.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1010871244552
FIREBASE_APP_ID=1:1010871244552:web:6ea059155e1eb142d0febd

# Super Admin Email Whitelist (Comma-separated)
SUPER_ADMIN_EMAILS=nros1978@gmail.com
